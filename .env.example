# ------------------------------------------------------------------
# Copie ce fichier en .env
# ------------------------------------------------------------------

# LLM (optionnel : sert au scoring fin et a la redaction des propositions)
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Telegram : alertes sur le telephone, meme quand le Mac est ferme.
# 1. Ouvre Telegram, cherche @BotFather, envoie /newbot, choisis un nom.
# 2. Il te donne un token du type 123456:ABC-DEF... -> TELEGRAM_BOT_TOKEN
# 3. Envoie n'importe quel message a ton nouveau bot.
# 4. Ouvre https://api.telegram.org/bot<TON_TOKEN>/getUpdates
#    et releve "chat":{"id":123456789} -> TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
